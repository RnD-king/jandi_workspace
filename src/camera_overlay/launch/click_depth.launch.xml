<launch>
  <arg name="image_topic" default="/camera/camera/color/image_raw"/>
  <arg name="depth_topic" default="/camera/camera/aligned_depth_to_color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/camera/color/camera_info"/>
  <arg name="max_sync_skew_ms" default="30.0"/>
  <node pkg="camera_overlay" exec="click_depth_node" name="click_depth" output="screen">
    <param name="image_topic" value="$(var image_topic)"/>
    <param name="depth_topic" value="$(var depth_topic)"/>
    <param name="camera_info_topic" value="$(var camera_info_topic)"/>
    <param name="max_sync_skew_ms" value="$(var max_sync_skew_ms)"/>
  </node>
</launch>
